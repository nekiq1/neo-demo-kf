# Скопируйте в .env. Не публикуйте заполненный .env.

# Защита админ-панели (рекомендуется логин + пароль; ADMIN_PIN оставлен для совместимости)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-unique-password
ADMIN_PIN=

# Уведомления: telegram | vk | both
NOTIFY_CHANNEL=telegram

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# VK API (токен сообщества/пользователя с правом отправки сообщений)
VK_ACCESS_TOKEN=
VK_PEER_ID=
VK_API_VERSION=5.199

# База данных PostgreSQL для Railway (добавьте сервис PostgreSQL и подключите DATABASE_URL)
DATABASE_URL=

# Публичные ссылки
PUBLIC_SITE_URL=https://your-domain.ru
VK_URL=https://vk.com/koreafanauto
TELEGRAM_URL=

# Подписки хранятся в PostgreSQL; автоматическая отправка писем подключается отдельно
